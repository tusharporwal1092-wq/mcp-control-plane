# RDS PostgreSQL 15 - the audit_log/approvals schema app/db.py and
# migrations/ apply (docs/roadmap.md Phase 7 Week 10: "Multi-AZ in prod,
# single in staging" - see local.cfg.rds_multi_az).
#
# Master password: NOT generated by Terraform. Tried a `random_password` +
# hand-built Secrets Manager entry first (matching how secrets.tf handles
# the other three secrets) and then re-read this phase's own exit
# criterion - "no secret appears in any Terraform state file" - which that
# approach directly violates (Terraform state always contains every
# attribute of every resource it manages, `random_password` included).
# `manage_master_user_password = true` below is RDS's native alternative:
# RDS itself generates the password and stores it in a Secrets Manager
# secret it creates and owns - Terraform only ever sees that secret's ARN
# (`aws_db_instance.postgres.master_user_secret[0].secret_arn`, used in
# iam.tf/outputs.tf), never the plaintext. helm/mcp-control-plane's
# ExternalSecret (templates/external-secret.yaml) reads that ARN directly
# rather than a Terraform-constructed secret, and builds DATABASE_URL from
# it via ESO's own templating - see that file's comment for why.
resource "aws_db_subnet_group" "postgres" {
  name       = local.name_prefix
  subnet_ids = module.vpc.private_subnets
}

resource "aws_security_group" "rds" {
  name_prefix = "${local.name_prefix}-rds-"
  vpc_id      = module.vpc.vpc_id
  description = "Postgres ingress from EKS nodes only"

  ingress {
    description     = "postgres from EKS nodes"
    from_port       = 5432
    to_port         = 5432
    protocol        = "tcp"
    security_groups = [module.eks.node_security_group_id]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  lifecycle {
    create_before_destroy = true
  }
}

resource "aws_db_instance" "postgres" {
  identifier     = local.name_prefix
  engine         = "postgres"
  engine_version = "15"

  instance_class    = local.cfg.rds_instance_class
  allocated_storage = 50
  storage_type      = "gp3"
  storage_encrypted = true

  db_name                     = "mcp_control_plane"
  username                    = "postgres"
  manage_master_user_password = true

  multi_az               = local.cfg.rds_multi_az
  db_subnet_group_name   = aws_db_subnet_group.postgres.name
  vpc_security_group_ids = [aws_security_group.rds.id]
  publicly_accessible    = false

  backup_retention_period = local.environment == "prod" ? 7 : 1
  deletion_protection     = local.cfg.rds_deletion_protection

  # Prod: a real snapshot survives a `terraform destroy`, on top of
  # deletion_protection already refusing to destroy it in the first place
  # without that flag being flipped off first (two independent gates, not
  # one). Staging: skip it - the whole point of staging is to be
  # cheaply, repeatedly destroyable, per this phase's own exit criterion.
  skip_final_snapshot       = local.environment != "prod"
  final_snapshot_identifier = local.environment == "prod" ? "${local.name_prefix}-final" : null

  apply_immediately = local.environment != "prod" # staging: changes take effect right away; prod: respect the maintenance window
}
