{
  "uid": "mcp-latency",
  "title": "MCP Control Plane / Latency",
  "tags": ["mcp-control-plane"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "p50 tool call duration, by tool",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le, tool_name) (rate(tool_call_duration_ms_milliseconds_bucket[5m])))",
          "legendFormat": "{{tool_name}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p95 tool call duration, by tool",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, tool_name) (rate(tool_call_duration_ms_milliseconds_bucket[5m])))",
          "legendFormat": "{{tool_name}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p99 tool call duration, by tool",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le, tool_name) (rate(tool_call_duration_ms_milliseconds_bucket[5m])))",
          "legendFormat": "{{tool_name}}"
        }
      ]
    }
  ]
}
