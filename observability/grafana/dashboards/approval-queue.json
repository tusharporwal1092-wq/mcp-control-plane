{
  "uid": "mcp-approval-queue",
  "title": "MCP Control Plane / Approval Queue",
  "tags": ["mcp-control-plane"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Pending approvals (current)",
      "description": "app/otel.py's approvals_pending UpDownCounter: +1 when a require_approval decision opens an approval (app/approvals.py::create_pending_approval), -1 when it's approved/denied (::decide_approval). Best-effort - drifts high if a pending approval silently expires past its 15-minute Redis TTL without ever being decided (see the ponytail note in app/otel.py).",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 5 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(approvals_pending)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Average approval decision time (5m)",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(approval_decision_duration_ms_milliseconds_sum[5m])) / sum(rate(approval_decision_duration_ms_milliseconds_count[5m]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Approval requests/min",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqpm" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(approval_requests_total[5m])) * 60"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Pending approvals over time, by tool",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (tool_name) (approvals_pending)",
          "legendFormat": "{{tool_name}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "p50/p95 approval decision time",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(approval_decision_duration_ms_milliseconds_bucket[15m])))",
          "legendFormat": "p50"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(approval_decision_duration_ms_milliseconds_bucket[15m])))",
          "legendFormat": "p95"
        }
      ]
    }
  ]
}
