{
  "uid": "mcp-tool-call-volume",
  "title": "MCP Control Plane / Tool Call Volume",
  "tags": ["mcp-control-plane"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests/min by tool",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqpm" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (tool_name) (rate(tool_calls_total[1m])) * 60",
          "legendFormat": "{{tool_name}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests/min by result_status",
      "description": "result_status is the audit_log decision label: allowed / denied / pending_approval / approval_denied / error / executor_timeout.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqpm" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (result_status) (rate(tool_calls_total[1m])) * 60",
          "legendFormat": "{{result_status}}"
        }
      ]
    }
  ]
}
